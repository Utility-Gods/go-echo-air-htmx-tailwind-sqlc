package pages

import "photogo/internal/templates/layout"

templ Home() {
    @layout.Base(layout.BaseProps{
        Title: "PhotoGo - Modern Go Web Template",
        Description: "A modern web application template using Go, HTMX, Tailwind CSS, and more.",
        }) {
        <div class="min-h-screen bg-slate-50">
            <!-- Hero Section -->
            <div class="py-24 sm:py-32">
                <div class="mx-auto max-w-7xl px-6 lg:px-8">
                    <div class="mx-auto max-w-2xl text-center">
                        <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">PhotoGo Template</h1>
                        <p class="mt-6 text-lg leading-8 text-gray-600">
                            A modern web application template using Go, HTMX, Tailwind CSS, and more.
                        </p>
                        <div class="mt-10 flex items-center justify-center gap-x-6">
                            <button
								class="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
								hx-post="/api/hello"
								hx-target="#message"
								hx-swap="innerHTML"
								hx-indicator="#spinner"
							>
								Try HTMX
								<span id="spinner" class="htmx-indicator">
									<svg class="animate-spin ml-1 mr-3 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
										<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
										<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
									</svg>
								</span>
							</button>
                        </div>
                        <div id="message" class="mt-4 text-gray-600"></div>
                        </div>
                        </div>
                        </div>

            <!-- Features Section -->
            <div class="mx-auto max-w-7xl px-6 lg:px-8 pb-24">
                <div class="mx-auto max-w-2xl">
                    <!-- Tech Stack -->
                    <div class="rounded-xl bg-white shadow-md p-8 mb-8">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4">Tech Stack</h2>
                        <ul class="space-y-4 text-gray-600">
                            <li class="flex items-start">
                                <div class="flex-shrink-0">
                                    <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                                        stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <p class="ml-3"><span class="font-semibold">Go + Echo:</span> Fast and minimalist web framework</p>
                                </li>
                                <li class="flex items-start">
                                    <div class="flex-shrink-0">
                                        <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    </div>
                                <p class="ml-3"><span class="font-semibold">HTMX:</span> Dynamic UI without JavaScript complexity
                                </p>
                                </li>
                                <li class="flex items-start">
                                    <div class="flex-shrink-0">
                                        <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                </div>
                                <p class="ml-3"><span class="font-semibold">Tailwind CSS:</span> Utility-first CSS framework</p>
                                </li>
                                <li class="flex items-start">
                                    <div class="flex-shrink-0">
                                        <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    </div>
                                <p class="ml-3"><span class="font-semibold">templ:</span> Type-safe HTML templates in Go</p>
                                </li>
                                <li class="flex items-start">
                                    <div class="flex-shrink-0">
                                        <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    </div>
                                    <p class="ml-3"><span class="font-semibold">PostgreSQL + sqlc:</span> Type-safe SQL in Go with code generation</p>
                                </li>
                                <li class="flex items-start">
                                    <div class="flex-shrink-0">
                                        <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    </div>
                                    <p class="ml-3"><span class="font-semibold">Task:</span> Modern task runner for development workflow</p>
                                </li>
                                </ul>
                                </div>
                                <!-- Development Commands -->
                                <div class="rounded-xl bg-white shadow-md p-8 mb-8">
                                    <h2 class="text-2xl font-bold text-gray-900 mb-4">Development Commands</h2>
                                    <div class="space-y-6">
                                        <div>
                                            <h3 class="text-lg font-semibold text-gray-900 mb-2">Setup</h3>
                                            <div class="bg-gray-900 rounded-lg p-4">
                                                <code class="text-sm text-gray-300">$ task install-tools</code>
                                            </div>
                                            <p class="mt-2 text-sm text-gray-600">Installs all required development tools including Air, templ, sqlc,
                                                and migrate.</p>
                                        </div>
                                
                                        <div>
                                            <h3 class="text-lg font-semibold text-gray-900 mb-2">Database Management</h3>
                                            <div class="space-y-2">
                                                <div class="bg-gray-900 rounded-lg p-4">
                                                    <code class="text-sm text-gray-300">$ task db-docker-up</code>
                                                </div>
                                                <div class="bg-gray-900 rounded-lg p-4">
                                                    <code class="text-sm text-gray-300">$ task migrate-up</code>
                </div>
                <div class="bg-gray-900 rounded-lg p-4">
                    <code class="text-sm text-gray-300">$ task migrate-create -- create_new_table</code>
                </div>
                </div>
                <p class="mt-2 text-sm text-gray-600">Start PostgreSQL in Docker, run migrations, and create new migration
                    files.</p>
                </div>
                
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 mb-2">Development Server</h3>
                    <div class="bg-gray-900 rounded-lg p-4">
                        <code class="text-sm text-gray-300">$ task dev</code>
                    </div>
                    <p class="mt-2 text-sm text-gray-600">Starts the development server with hot reload for Go code, templates,
                        and CSS at <a href="http://localhost:6969"
                            class="text-indigo-600 hover:text-indigo-500">http://localhost:6969</a></p>
                </div>
                
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 mb-2">Code Generation</h3>
                    <div class="space-y-2">
                        <div class="bg-gray-900 rounded-lg p-4">
                            <code class="text-sm text-gray-300">$ task sqlc-generate</code>
                        </div>
                        <div class="bg-gray-900 rounded-lg p-4">
                            <code class="text-sm text-gray-300">$ task templ-generate</code>
                        </div>
                    </div>
                    <p class="mt-2 text-sm text-gray-600">Generate type-safe Go code from SQL queries and templ templates.</p>
                </div>
                </div>
                    </div>
                    </div>
                    </div>
                    </div>
                    }
}